# Obrigatórios
SECRET_KEY=troque-por-pelo-menos-32-caracteres-aleatorios
OWNER_PASSWORD=senha-do-dono-no-painel
AGENT_TOKEN=token-longo-compartilhado-com-o-agente

# Operador da empresa (opcional): revisa e aponta anomalias, sem mexer em configurações
OPERATOR_PASSWORD=
# 1 = alertas não críticos esperam o operador confirmar antes de ir ao dono
OPERATOR_REVIEW=0
# Se o operador não revisar nesse prazo, o alerta segue marcado como "não revisado"
REVIEW_TIMEOUT_MIN=10

# A Railway preenche DATABASE_URL quando você liga o Postgres ao serviço
# DATABASE_URL=postgresql://...

SITE_NAME=Nome do local
TIMEZONE=America/Sao_Paulo
DIGEST_HOUR=8

# WhatsApp: console (teste), baileys (QR Code), meta, evolution ou zapi
WHATSAPP_PROVIDER=console

# Evolution e Z-API: compõe o endereço /webhook/whatsapp/<segredo>
WHATSAPP_WEBHOOK_SECRET=

# Conector próprio por QR Code (pasta whatsapp/)
BAILEYS_URL=
BAILEYS_KEY=

# API oficial da Meta
META_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
META_TEMPLATE_LANG=pt_BR

# Evolution API
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Z-API
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Opcional: descrição da imagem em uma frase nos alertas
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-5-5

# Retenção, em dias
RETENTION_METRICS_DAYS=30
RETENTION_SNAPSHOTS_DAYS=15
RETENTION_EVENTS_DAYS=90
